<?xml version="1.0" encoding="utf-8"?>
<!-- "NEW clickable" chip: light-blue fill, 1dp accent border, rounded, ripple on tap. See values/new_clickable.xml -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/new_clickable_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/new_clickable_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/new_clickable_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>