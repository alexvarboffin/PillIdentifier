<?xml version="1.0" encoding="utf-8"?>
<!-- Same ids as item_name_value_1_2 (Simple2TextViewHolder): textView2 = NEW clickable concept-name chip, textView1 = "RxCUI <id>". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lLayout1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#EBF3F9"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/textView2"
        style="@style/NewClickableChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="alprazolam 0.5 MG Oral Tablet [Xanax]  &#8250;" />

    <TextView
        android:id="@+id/textView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/ndc_card_missing"
        android:textSize="12sp"
        tools:text="RxCUI 141928" />

    <!-- roadmap #5 (getAllRelatedExtension): NON-clickable extras, hidden unless data is present -->
    <TextView
        android:id="@+id/conceptPsn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#616161"
        android:textSize="12sp"
        android:textStyle="italic"
        android:visibility="gone"
        tools:text="Prescribable name: Xanax 0.5 MG Oral Tablet"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/conceptBadges"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/badgeRxPrescribable"
            style="@style/InfoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/related_badge_rx_prescribable" />

        <TextView
            android:id="@+id/badgeVeterinary"
            style="@style/InfoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/related_badge_veterinary"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>